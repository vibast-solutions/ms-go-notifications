{
    "swagger": "2.0",
    "info": {
        "description": "Transactional email API for the Vibast notifications service. All routes require a bearer API key.",
        "title": "Vibast Notifications API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/v1",
    "paths": {
        "/emails": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Validate a send request, store it queued (or suppressed if every recipient is suppressed), and hand it to the dispatcher. Returns 202 for a new message and 200 for an idempotent replay of the same idempotencyKey.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "emails"
                ],
                "summary": "Accept an email",
                "parameters": [
                    {
                        "description": "Email to send",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.SendEmailRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Idempotent replay of an existing message",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.SendEmailResponse"
                        }
                    },
                    "202": {
                        "description": "Accepted (new message)",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.SendEmailResponse"
                        }
                    },
                    "400": {
                        "description": "validation_error",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "domain_not_allowed",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "payload_too_large",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "internal_error",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/emails/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the message status, recipients and event timeline. Bodies and attachment contents are never returned. 404 when the id is unknown or owned by another API key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "emails"
                ],
                "summary": "Get an email's status and timeline",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Message id (ULID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.EmailResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "not_found",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "internal_error",
                        "schema": {
                            "$ref": "#/definitions/github_com_vibast-solutions_ms-go-notifications_app_dto_v1.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/webhooks/ses": {
            "post": {
                "description": "Receives AWS SNS deliveries carrying SES events. The SNS signature is verified and the topic ARN checked against the allow-list; there is no bearer auth. SubscriptionConfirmation messages are auto-confirmed; Notification messages update message/recipient state. Returns 200 once a message is verified (even for an unknown message id), 403 on a bad signature or disallowed topic, and 400 on a malformed body.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhooks"
                ],
                "summary": "SES event webhook (SNS)",
                "responses": {
                    "200": {
                        "description": "Accepted"
                    },
                    "400": {
                        "description": "Malformed SNS envelope"
                    },
                    "403": {
                        "description": "Bad signature or disallowed topic"
                    },
                    "500": {
                        "description": "Internal error"
                    }
                }
            }
        }
    },
