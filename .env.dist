# ms-go-notifications configuration template.
# Copy to .env for local development; real values never live in this file.

# --- HTTP ---
HTTP_ADDR=:8080

# --- Database (required) ---
# MySQL DSN, e.g. user:pass@tcp(127.0.0.1:3306)/notifications?parseTime=true
DATABASE_DSN=
# Connection pool; keep DB_MAX_OPEN_CONNS >= WORKER_CONCURRENCY + HTTP headroom.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# --- Sending domains (required) ---
# Comma-separated sender domains; superset of what API keys may be given.
# `notifications apikey create/set-domains` validates --domains against this list.
ALLOWED_DOMAINS=

# --- Email provider ---
# ses | log (log prints emails to stdout, for development)
EMAIL_PROVIDER=log
# Required when EMAIL_PROVIDER=ses (standard AWS credential env/roles apply).
AWS_REGION=
# SES configuration set whose event destination is the SNS topic.
SES_CONFIGURATION_SET=
# Comma-separated SNS topic ARNs the webhook accepts; others are rejected.
SNS_ALLOWED_TOPIC_ARNS=

# --- Processing (in-process worker pool; MySQL is the queue) ---
# Parallel senders (worker pool size).
WORKER_CONCURRENCY=4
# In-memory hand-off channel size (overflow is harmless - the sweeper drains from DB).
DISPATCH_BUFFER=1024
# Sweeper cadence and when a 'sending' row is considered abandoned.
SWEEP_INTERVAL=10s
STALE_LOCK_AFTER=5m
# Retry policy: attempts and exponential backoff base.
SEND_MAX_ATTEMPTS=5
SEND_BACKOFF_BASE=5s
# Messages/second, in-process limiter (split across instances).
PROVIDER_MAX_SEND_RATE=10

# --- Validation limits ---
MAX_RECIPIENTS=50
MAX_PAYLOAD_BYTES=10485760

# --- Reputation circuit breaker ---
REPUTATION_BOUNCE_THRESHOLD=0.04
REPUTATION_COMPLAINT_THRESHOLD=0.0008
REPUTATION_MIN_SAMPLE=50

# --- API versioning ---
# When set (date, e.g. 2027-06-30), v1 responses carry Deprecation/Sunset headers.
API_V1_SUNSET=

# --- Misc ---
SWAGGER_ENABLED=false
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
